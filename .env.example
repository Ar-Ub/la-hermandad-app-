# Copia este archivo a ".env" y llena los valores desde tu proyecto de Supabase
# (Dashboard > Project Settings > API). Sin esto, la app corre igual pero
# muestra datos de muestra en vez de datos reales.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Respaldo automático en Google Sheets (opcional). Ver sheets/Code.gs para
# instrucciones de instalación. Sin esto, la app funciona igual, solo que
# no manda copia a Sheets.
VITE_SHEETS_WEBHOOK_URL=
VITE_SHEETS_WEBHOOK_TOKEN=
